# Aniki API environment variables
# Copy to .env and fill in values

DATABASE_URL=postgres://aniki:aniki@localhost:5432/aniki
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-jwt-secret-change-in-production
SPEECHMATICS_API_KEY=
SPEECHMATICS_REGION=eu
APP_URL=http://localhost:3000
API_URL=http://localhost:8080
PORT=8080

# LLM / RAG (optional in dev — stubs return helpful messages)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4.1
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-20250514
CONFIRM_MODEL=gpt-4.1-mini
