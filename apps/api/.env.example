# Aniki API environment variables
# Copy to .env and fill in values

DATABASE_URL=postgres://aniki:aniki@localhost:5432/aniki
# Raise if you see "pool timed out while waiting for an open connection"
DATABASE_MAX_CONNECTIONS=20
DATABASE_ACQUIRE_TIMEOUT_SECS=10
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-jwt-secret-change-in-production
SPEECHMATICS_API_KEY=
SPEECHMATICS_REGION=eu
APP_URL=http://localhost:3000
API_URL=http://localhost:8080
# Comma-separated extra browser origins (custom domain). APP_URL and desktop locals are always allowed.
CORS_ORIGINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: raises GitHub API rate limits for GET /desktop/latest
GITHUB_TOKEN=
# production on Fly (fly.toml). Unset locally so missing LLM/STT keys still boot.
# ANIKI_ENV=production
PORT=8080

# LLM / RAG (optional in dev — stubs return helpful messages)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5.6-luna
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-20250514
CONFIRM_MODEL=gpt-5.6-luna
